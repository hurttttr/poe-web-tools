{
  "manifest_version": 3,
  "name": "PoE Web Tools",
  "version": "1.0.3",
  "description": "流放之路常用网页工具：FilterBlade、poe.ninja 与 PoE Planner 异界天赋树简体中文界面、站点快捷跳转。术语以编年史为准，支持中文 / 双语 / 原文切换，不影响站点功能。",
  "author": "WorkBuddy",
  "content_scripts": [
    {
      "matches": [
        "https://www.filterblade.xyz/*",
        "https://filterblade.xyz/*",
        "https://beta.filterblade.xyz/*",
        "https://poe.ninja/*",
        "https://poeplanner.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.filterblade.xyz/*",
        "https://filterblade.xyz/*",
        "https://beta.filterblade.xyz/*"
      ],
      "js": ["bridge-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.filterblade.xyz/*",
        "https://filterblade.xyz/*",
        "https://beta.filterblade.xyz/*"
      ],
      "js": ["bridge-main.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PoE Web Tools · 站点切换 / 汉化",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  }
}
